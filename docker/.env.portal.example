# Copy to a private env file; never commit real credentials.
WEB_PASSWORD=replace-with-a-strong-admin-password
API_KEY=replace-with-a-strong-private-master-key
ABV_PORTAL_PUBLIC_URL=http://127.0.0.1:8046
ABV_PORTAL_API_BASE_URL=http://127.0.0.1:8046/v1
ABV_PORTAL_REGISTRATION_OPEN=true
ABV_PORTAL_TRUST_PROXY=false
# Accounts use original user Tokens. Independent payment/billing is disabled.
